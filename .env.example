# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider Configuration ('openai', 'local_llama', or 'auto')
LLM_PROVIDER=auto

# Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI API Key (Leave empty to use smart offline academic mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Authentication
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Local LLaMA / Ollama Settings (Optional)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3
